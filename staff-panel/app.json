{
  "expo": {
    "name": "BioSyncAI Staff",
    "slug": "staff-panel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "biosync-staff",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.biosync.staff",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "BioSyncAI uses your location to route you to patient home appointments and provide live ETA to patients.",
        "NSCameraUsageDescription": "BioSyncAI uses the camera to scan sample barcodes and capture specimen verification photos."
      }
    },
    "android": {
      "package": "com.biosync.staff",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-camera",
      "expo-notifications"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
