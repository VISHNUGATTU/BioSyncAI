{
  "expo": {
    "name": "BioSync AI Staff",
    "slug": "staff-panel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "biosync-staff",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.biosync.staff",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "BioSync AI uses your location to route you efficiently to patient home appointments and provide live arrival ETA to patients.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "BioSync AI monitors route progression to update patient dispatch tracking and cold-chain sample safety windows.",
        "NSCameraUsageDescription": "BioSync AI uses the camera to scan diagnostic sample tube barcodes and capture specimen custody verification photos."
      }
    },
    "android": {
      "package": "com.biosync.staff",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0f172a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-camera",
      "expo-notifications"
    ],
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "shortName": "BioSync Staff",
      "name": "BioSync AI Staff & Phlebotomy Portal",
      "description": "Mobile Workforce Management & Sample Cold-Chain Tracking Application",
      "themeColor": "#0f172a",
      "backgroundColor": "#0f172a",
      "display": "standalone"
    }
  }
}
