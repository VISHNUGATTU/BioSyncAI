# =====================================================================
# BioSync AI - Server Environment Configuration Template (.env.example)
# Public Repository Template: Copy to .env and replace with your secrets
# DO NOT COMMIT SENSITIVE PRODUCTION CREDENTIALS TO VERSION CONTROL
# =====================================================================

PORT=6446
NODE_ENV=development

# Database Configuration (MongoDB Atlas Connection URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/biosync_db?retryWrites=true&w=majority

# Security & Authentication (Generate with: openssl rand -base64 32)
JWT_SECRET=your_super_secret_jwt_encryption_key_here_min_32_chars

# Cross-Origin Service URLs
PUBLIC_URL=http://localhost:6446
CLIENT_URL=http://localhost:8082
ADMIN_URL=http://localhost:5173
AI_ENGINE_URL=http://localhost:8000

# AI & LLM Service Credentials
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHereForClinicalChat

# Cloudinary Media Storage (For Laboratory Specimen Verification Photos)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMS & Communication Gateways (Fast2SMS for Indian Doorstep OTP)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Transporter Mail Credentials (SMTP for Lab Reports & Invoices)
EMAIL_USER=notifications@biosync.ai
EMAIL_APP_PASSWORD=your_secure_smtp_app_password

# Firebase Admin SDK (Base64-encoded Service Account JSON for Push Notifications)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"biosync-ai","private_key_id":"...","private_key":"...","client_email":"..."}

# Automated Clinical Health Recalibration Cron Schedule (Default: Every midnight)
RECALIBRATION_CRON_SCHEDULE=0 0 * * *
