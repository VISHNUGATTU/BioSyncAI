# ==============================================================================
# BIOSYNC AI - SERVER ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network & Mode
PORT=6446
NODE_ENV=production
PUBLIC_URL=http://localhost:6446

# Client / Panel URLs (CORS Whitelisting)
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173

# Database (MongoDB Connection String)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/biosync_db?retryWrites=true&w=majority

# Authentication Secret (JWT)
JWT_SECRET=your_super_secure_random_jwt_secret_key_here

# Google Gemini Flash API Key (AI Diagnostics & Computer Vision Fallback)
GEMINI_API_KEY=your_google_gemini_api_key

# Python AI Engine Microservice URL
AI_ENGINE_URL=http://localhost:8000/api/v1/analyze

# Cloudinary Cloud Storage (Specimen Photos & Clinical Evidence)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Fast2SMS OTP Gateway (Patient Doorstep Verification)
FAST2SMS_API_KEY=your_fast2sms_api_key

# Automated Email Dispatch (Clinical Lab Reports & Welcome Mails)
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_email_app_password

# Firebase Admin SDK (Native FCM Push Delivery) - Optional if using Expo Push API
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your_project_id","private_key_id":"...","private_key":"...","client_email":"..."}

# Baseline Recalibration Cron Schedule (Default: Every night at 2:00 AM)
RECALIBRATION_CRON_SCHEDULE=0 2 * * *
