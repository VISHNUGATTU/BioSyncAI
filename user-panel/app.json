{
  "expo": {
    "name": "BioSync AI",
    "slug": "biosync-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "biosync-user",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.biosync.patient",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "BioSync AI requires camera access to scan packaged food barcodes and meal nutrition.",
        "NSLocationWhenInUseUsageDescription": "BioSync AI uses your location to recommend home phlebotomy dispatch availability."
      }
    },
    "android": {
      "package": "com.biosync.patient",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "CAMERA",
        "NOTIFICATIONS",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-camera",
      "expo-notifications"
    ]
  }
}
